# --- Core ---
PORT=3000
NODE_ENV=development            # set to "production" when deployed (enables Secure cookies + HSTS)
APP_URL=http://localhost:3000   # public base URL; used in sign-in links
ACCESS_MODE=production          # "test" = NON-PRODUCTION: any email can sign in. Never use test on a public deployment.
DATA_DIR=./data/runtime         # where db.json lives (mount a persistent volume in production)
DATA_ENCRYPTION_KEY=            # 64 hex chars (openssl rand -hex 32) to encrypt saved assessments at rest

# --- AI (server-side only; never sent to the browser) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=40               # AI calls per user per day
AI_RETENTION_NOTE=              # optional: override the retention wording shown to users (match your actual Anthropic agreement)

# --- Offer / copy (all configurable) ---
OFFER_PRICE=27
OFFER_CURRENCY=USD
CHECKOUT_URL=                   # GoHighLevel order-form URL
SUPPORT_EMAIL=
COACHING_URL=                   # The Art of Being You page. Leave empty to hide the link.

# --- Paid access (GoHighLevel) ---
GHL_WEBHOOK_SECRET=             # shared secret your GHL workflow sends in the x-webhook-secret header
GHL_PRODUCT_ID=                 # optional: only accept this product id
ELIGIBLE_TICKETS=general_admission,vip
ADMIN_TOKEN=                    # long random string for /admin and /api/admin/*

# --- Sign-in email delivery ---
EMAIL_WEBHOOK_URL=              # e.g. a GHL inbound-webhook workflow or Zapier hook that emails {to, subject, text, link}
EMAIL_WEBHOOK_SECRET=
